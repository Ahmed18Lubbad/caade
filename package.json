{
  "name": "caade-gaza-website",
  "version": "2.0.0",
  "private": true,
  "description": "Static Next.js site for the Agricultural and Environmental Development Cooperative Association",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "node scripts/lint.mjs",
    "check": "node scripts/check-content.mjs && npm run lint",
    "format": "prettier --write \"app/**/*.{js,jsx}\" \"src/**/*.{js,jsx}\" \"scripts/**/*.mjs\""
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {}
}
